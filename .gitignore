# Tooling / OS / editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Coverage / test output
.coverage
htmlcov/
.pytest_cache/
.tox/
coverage.xml
