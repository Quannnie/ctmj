# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` itself is git-ignored — never commit it.
# Every value below has a safe development default, so the app boots without
# this file. Set DJANGO_DEBUG=False in any non-local environment.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-50-character-random-string
DJANGO_DEBUG=True
# Comma-separated. Use "*" only for throwaway local experiments.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Model loading ---------------------------------------------------------
# auto  -> use ./models if it contains the artefacts, otherwise fall back to hf
# local -> ./models only (no network access)
# hf    -> always pull from Hugging Face Hub
# none  -> never load; the site runs and explains that predictions are offline
CTMJ_MODEL_SOURCE=auto

# Local directory holding the five joblib artefacts.
CTMJ_MODEL_DIR=models

# Hugging Face repository holding the trained artefacts.
CTMJ_HF_REPO=quanghuynh0122/datamining_models

# Read token for private repos. Prefer a read-only token, and prefer passing it
# via the environment over storing it here. Only needed when the source is hf.
HF_TOKEN=
